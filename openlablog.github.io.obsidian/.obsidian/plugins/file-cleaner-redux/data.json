{
  "deletionDestination": "system",
  "obsidianTrashCleanupAge": -1,
  "excludeInclude": 0,
  "excludedFolders": [
    "javascripts"
  ],
  "attachmentsExcludeInclude": 1,
  "attachmentExtensions": [
    "jpg",
    "jpeg",
    "png",
    "gif",
    "doc",
    "docx",
    "xls",
    "xlsx",
    "ppt",
    "pptx",
    "pdf"
  ],
  "deletionConfirmation": true,
  "runOnStartup": false,
  "removeFolders": true,
  "ignoredFrontmatter": [],
  "ignoreAllFrontmatter": false,
  "codeblockTypes": [],
  "deleteEmptyMarkdownFiles": true,
  "deleteEmptyMarkdownFilesWithBacklinks": true,
  "fileAgeThreshold": 0,
  "closeNewTabs": false,
  "deleteEmptyFileOnClose": false,
  "ExternalPlugins": {
    "Excalidraw": {
      "TreatAsAttachments": false
    }
  }
}